# Copy this file to .env and fill in real values. Never commit .env.

# Required only if you enable LLM-assisted relevance classification (Phase 3)
# or use unified_pipeline.py to actually call an LLM (Phase 4/10).
# When unset, Decoy runs entirely with local/keyword-based logic and makes
# no network calls.
ANTHROPIC_API_KEY=

# Required alongside ANTHROPIC_API_KEY when the key is identity-linked
# (tied to a user identity spanning multiple workspaces) rather than a
# plain workspace-scoped key -- the API rejects requests from such a key
# with a 400 unless this header is also sent. Not needed for a plain
# workspace-scoped key. Find it in the Anthropic Console under
# Settings -> Workspaces (starts with "wrkspc_").
ANTHROPIC_WORKSPACE_ID=

# Optional: path to the overrides file (always_mask / never_mask).
# Defaults to .decoy/overrides.json in the current working directory.
DECOY_OVERRIDES_PATH=

# Optional: enables encrypted-at-rest persistence of the vault to disk
# (session survives process restarts). If unset, the vault is in-memory
# only and is lost when the process exits.
DECOY_VAULT_PERSIST=false

# Optional: base64-encoded 32-byte key used to encrypt the persisted vault
# and audit log. If unset and persistence is enabled, a key is generated
# on first run and stored at .decoy/vault.key (0600 permissions) -- treat
# that file as a secret.
DECOY_ENCRYPTION_KEY=
